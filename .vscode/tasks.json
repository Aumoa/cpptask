{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B",
                "build",
                "-S",
                ".",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
                "-DCMAKE_CXX_STANDARD=23"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": [],
            "detail": "Configure CMake project with C++23 support"
        },
        {
            "label": "CMake Build Library",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build",
                "--config",
                "Debug",
                "--parallel"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "dependsOn": "CMake Configure",
            "detail": "Build cpptask library"
        },
        {
            "label": "CMake Configure Test",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B",
                "test/build",
                "-S",
                "test",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
                "-DCMAKE_CXX_STANDARD=23"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": [],
            "detail": "Configure CMake test project"
        },
        {
            "label": "CMake Build Test",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "test/build",
                "--config",
                "Debug",
                "--parallel"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "dependsOn": [
                "CMake Build Library",
                "CMake Configure Test"
            ],
            "detail": "Build cpptask test executable"
        },
        {
            "label": "Run Tests",
            "type": "shell",
            "command": "./test/build/cpptask_test",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "dependsOn": "CMake Build Test",
            "detail": "Run cpptask tests"
        },
        {
            "label": "Clean Build",
            "type": "shell",
            "command": "rm",
            "args": [
                "-rf",
                "build",
                "test/build"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "detail": "Clean all build directories"
        }
    ]
}