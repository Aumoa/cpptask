{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug cpptask_test",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/test/build/cpptask_test",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake Build Test",
            "miDebuggerPath": "/usr/bin/gdb",
            "logging": {
                "moduleLoad": false,
                "programOutput": true,
                "trace": false
            },
            "internalConsoleOptions": "openOnSessionStart"
        }
    ]
}